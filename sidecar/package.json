{
  "name": "metroforge-sidecar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "bun run index.ts",
    "smoke": "bun run smoke-test.ts",
    "compile:linux": "bun build --compile --target=bun-linux-x64 ./index.ts --outfile ../../metroforge-native/dist-sidecar/metroforge-sidecar",
    "compile:windows": "bun build --compile --target=bun-windows-x64 ./index.ts --outfile ../../metroforge-native/dist-sidecar/metroforge-sidecar.exe",
    "compile:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 ./index.ts --outfile ../../metroforge-native/dist-sidecar/metroforge-sidecar-darwin-arm64"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.3"
  }
}
